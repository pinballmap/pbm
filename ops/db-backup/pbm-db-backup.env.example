# Copy to /etc/pbm-db-backup.env on the droplet, then:
#   chown root:root /etc/pbm-db-backup.env && chmod 600 /etc/pbm-db-backup.env
# Values come from the DO control panel (Databases > Connection details).

# Postgres (libpq reads these directly)
PGHOST=your-cluster-do-user-0000000-0.x.db.ondigitalocean.com
PGPORT=25060
PGDATABASE=pbm
PGUSER=doadmin
PGPASSWORD=
PGSSLMODE=require

# S3, using an IAM user that can only write to the backup bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-1
S3_BUCKET=YOUR-BACKUP-BUCKET

# PGDG client binaries matching the cluster's major version (e.g. 17)
PG_DUMP=/usr/lib/postgresql/17/bin/pg_dump
PG_RESTORE=/usr/lib/postgresql/17/bin/pg_restore

# Dokku app whose env config is backed up too; leave blank to skip
DOKKU_APP=pbm

# Optional: ping URL from healthchecks.io or similar
HEALTHCHECK_URL=
