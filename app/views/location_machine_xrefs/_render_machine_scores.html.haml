%div.highest_score.center
  %p.bold.font18
    Your highest score on
    %span.black
      #{lmx.machine.name}
      #{lmx.machine.year_and_manufacturer}
  - if highest
    %p.bold.font22{:style => "padding-top: 0;"}="#{number_with_delimiter(highest, :delimiter => ",")}"
  - elsif !user_signed_in?
    %p.font18.italic{:style => "padding-top: 0;"}
      none yet (sign up to track scores)
  - else
    %p.font18.italic{:style => "padding-top: 0;"}
      none yet (track your scores!)
= render :partial => 'machine_score_xrefs/add_high_score', :locals => {:lmx => lmx}
- if user_signed_in?
  - if scores.present?
    .hr
    %p.center.bold.font18{:style => "padding-top: 0;margin-bottom: 0;color: #eb9633"}
      Your high scores on this copy
  - scores.each_with_index do |msx, index|
    %div{:id => "container_past_high_score_#{msx.id}"}
      .high_score_rank_row.mb_8
        %span.high_score_rank="##{index + 1}"
        %div.high_score_rank_content
          %div.high_score_new_line{:id => "editing_past_high_score_#{msx.id}", :style=>"display:none;"}
            = form_tag machine_score_xref_path(id: msx.id), :id => "update_#{msx.id}", :method => 'put' do
              = text_field_tag 'score', "#{msx.score}", :class => 'edit_mode'
              %br/
              = submit_tag 'Update Score', :class => 'update_high_score_submit'
              %a.button{:id => "cancel_update_high_score_#{msx.id}"} Cancel Update
          %div.high_score_new_line{:id => "showing_past_high_score_#{msx.id}"}
            %span.high_score="#{number_with_delimiter(msx.score, :delimiter => ",")}"
            .clear
            %div.high_score_author
              - if !msx.updated_at.nil?
                %span.high_score_date= msx.updated_at.strftime("%b %d, %Y")
                - if msx.updated_at != msx.created_at
                  %span.score_edited_asterisk *
                  %span.score_edited_tooltip
                    Score has been edited
              %a.ml_8.update_high_score_button.button{:id => "edit_high_score_#{msx.id}"} edit
              = form_tag machine_score_xref_path(id: msx.id), :id => "remove_high_score_#{msx.id}", :method => 'delete' do
                = submit_tag 'delete', :class => 'delete_high_score_button'

              :javascript
                $('#cancel_update_high_score_#{msx.id}').click(function () {
                  $('#editing_past_high_score_#{msx.id}').css('display', 'none')
                  $('#showing_past_high_score_#{msx.id}').css('display', 'block')

                  return false;
                  });
                $('#edit_high_score_#{msx.id}').click(function () {
                  $('#editing_past_high_score_#{msx.id}').css('display', 'block')
                  $('#showing_past_high_score_#{msx.id}').css('display', 'none')

                  return false;
                  });
                $('#update_#{msx.id}').submit(function () {
                    var form = $(this);
                    if (confirm("Update this score?")) {
                      $.post(form.attr('action'), form.serialize(), function (data) {
                        $('#editing_past_high_score_#{msx.id}').css('display', 'none');
                        $('#showing_past_high_score_#{msx.id}').css('display', 'block');
                        $('#score_container_lmx_#{lmx.id}').load('/location_machine_xrefs/#{lmx.id}/render_machine_scores');
                      });
                    }

                    return false;
                  });
                $('#remove_high_score_#{msx.id}').submit(function () {
                    var form = $(this);
                    if (confirm("Remove this score?")) {
                      $('#showing_past_high_score_#{msx.id}').fadeOut('slow', function() {
                        $.post(form.attr('action'), form.serialize(), function (data) {});
                      });
                    }

                    return false;
                  });
- all_scores_only_user = user_signed_in? && scores.present? && all_scores.pluck(:user_id).all?(current_user.id)
- if !all_scores_only_user && all_scores.present?
  %p.center.bold.font18{:style => "margin-bottom: 0;color: #dd7a6d"}
    Everyone's scores on this copy
  - all_scores.each_with_index do |msx, index|
    %div{:id => "container_past_high_score_#{msx.id}"}
      .high_score_rank_row.mb_8
        %span.high_score_rank="##{index + 1}"
        %div.high_score_rank_content
          %div.high_score_new_line{:id => "showing_past_high_score_#{msx.id}"}
            %span.high_score="#{number_with_delimiter(msx.score, :delimiter => ",")}"
            .clear
            %div.high_score_author
              - if msx.user
                = link_to msx.user.username, "#{request.scheme}://#{request.host_with_port}/users/#{msx.user.username}/profile", :class => 'bold'
                - if msx.user.admin_title.present?
                  %span{:class => "user_admin_container"}
                    = image_tag('icons/shield-account.svg', :class => 'user_icon user_admin')
                - if lmx.location.operator_id.present? && lmx.location.operator_id == msx.user.operator_id
                  %span{:class => "user_operator_container"}
                    = image_tag('icons/wrench.svg', :class => 'user_icon user_operator')
                - if msx.user.contributor_rank.present?
                  - rank = msx.user.contributor_rank.gsub(' ', '')
                  %span{:class => "rank_icon_#{rank}"}
                    =image_tag("rank/#{rank}.png", :class => "user_icon rank_icon")
                - if msx.user.flag.present?
                  %span{:class => "user_flag_container"}
                    =image_tag("/flags/#{msx.user.flag}.png", :class => "user_icon user_flag", :alt => "#{msx.user.flag} flag")
              - else
                DELETED USER
              - if !msx.updated_at.nil?
                %span.high_score_date{:style => "margin-left: 8px;"}= msx.updated_at.strftime("%b %d, %Y")
