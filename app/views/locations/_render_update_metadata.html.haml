%div.metadata[l, :metadata_show]
  - if (l.state.blank? && l.zip.blank?)
    %div.address_full= [l.street, l.city].join(', ')
  - elsif (l.state.blank?)
    %div.address_full= [l.street, l.city + " " + l.zip].join(', ')
  - elsif (l.zip.blank?)
    %div.address_full= [l.street, l.city, l.state].join(', ')
  - else
    %div.address_full= [l.street, l.city, l.state + " " + l.zip].join(', ')
  - if l.location_type || l.all_ages? || l.payment_type?
    %div.location_meta_row.m_10
      - if l.location_type
        %div.location_meta_item
          - if l.location_type.icon.present?
            =image_tag("icons/#{l.location_type.icon}.svg", :alt => l.location_type.icon, :class => 'meta_icon')
          %span= l.location_type.name
      - if l.all_ages?
        %div.location_meta_item
          =image_tag("icons/human-male-girl.svg", :alt => "all ages", :class => 'meta_icon')
          %span= l.all_ages == "Yes" ? "All Ages" : "All Ages At Times"
      - if l.payment_type?
        %div.location_meta_item
          =image_tag("icons/coins-solid-full.svg", :alt => "free play", :class => 'meta_icon')
          %span= l.payment_type
  - if mobile_device? && !l.phone.blank?
    %div.phone
      = image_tag('icons/phone.svg', :class => 'meta_icon')
      = link_to l.phone, "tel:" + l.phone, :type => 'tel'
  - else
    - if l.phone?
      %div.phone
        = image_tag('icons/phone.svg', :class => 'meta_icon')
        = l.phone
  - if l.website?
    %div.website
      = image_tag('icons/web.svg', :class => 'meta_icon')
      = link_to "Website", l.website, :class => 'website', :target => 'blank'
  - if l.place_id?
    %div.hours
      = image_tag('icons/clock-time-four-outline.svg', :class => 'meta_icon')
      = link_to "Hours", "https://www.google.com/maps/place/?q=place_id:" + l.place_id, :class => 'hours', :target => 'blank'
      %span.grey.italic (Google Maps)
  - if (l.operator_id)
    %div.operator
      = image_tag('icons/wrench.svg', :class => 'meta_icon')
      %span.darkgrey Operated by:
      %span
        - if l.operator.website.blank?
          &nbsp;#{l.operator.name}
        - else
          = link_to l.operator.name, l.operator.website, target: '_blank'
        - if l.operator_email_opt_in
          = image_tag('icons/email-outline.svg', class: 'copy_icon', data: { copy: l.operator_email_opt_in })
        - if l.operator_phone_opt_in
          = image_tag('icons/phone.svg', class: 'copy_icon', data: { copy: l.operator_phone_opt_in })
  - if !l.description.blank?
    %div.description
      = image_tag('icons/notebook-outline.svg', :class => 'meta_icon float_l')
      %div[l, :desc_show]= l.description
  %div[l, :last_updated]
    = render :partial => 'locations/render_last_updated', :locals => {:l => l}

%div[l, :metadata_edit]{:style => 'display:none'}
  %div.mb_8{:style => 'line-height: 20px;'}
    Is this location
    %span.red.bold closed or are all the machines gone?
    Simply remove the machines.
  %div.mb_20{:style => 'line-height: 20px;'}
    Does the location have a new name or address?
    = link_to 'Contact us', global_contact_path, :class => 'bold brightpurple'
    with the details.
  = form_tag update_metadata_locations_path(:action => 'update_metadata', id: l.id), :id => "update_metadata_#{l.id}", :method => 'patch' do
    = hidden_field_tag :id, l.id
    = label_tag "Phone #: "
    = text_field_tag "new_phone_#{l.id}", l.phone, :class => 'edit_mode'
    .clear
    = label_tag "Website: "
    = text_field_tag "new_website_#{l.id}", l.website, :class => 'edit_mode'
    .clear
    = label_tag "Operator: "
    = select_tag "new_operator_#{l.id}", options_for_select([['']]) + options_from_collection_for_select(Operator.order(:name).all, 'id', 'name', l.operator_id)
    .clear
    = label_tag "Location Type: "
    = select_tag "new_location_type_#{l.id}", options_for_select([['']]) + options_from_collection_for_select(LocationType.all, 'id', 'name', l.location_type_id)
    .clear
    = label_tag "All Ages? "
    = select_tag "new_all_ages_#{l.id}", options_for_select([['']] + Location::ALL_AGES_VALUES, l.all_ages)
    .clear
    = label_tag "Free Play? "
    = select_tag "new_payment_type_#{l.id}", options_for_select([['']] + Location::PAYMENT_TYPE_VALUES, l.payment_type)
    .clear
    = label_tag "Location Description: "
    = text_area_tag "new_desc_#{l.id}", (l.description.to_s == '') ? '' : l.description, :cols => 20, :rows => 3, :class => 'edit_mode', :placeholder => 'Hours; type of payment system(s) they use (door fee, cash, cards); accessibility issues'
    .clear
    %div.button_row
      = submit_tag 'Save', :class => "save_button", :id => "save_metadata_#{l.id}"
      = button_tag 'Cancel', :id => "metadata_cancel_#{l.id}", :class => "cancel_button", :type => 'button'

:javascript
  $('#update_metadata_#{l.id}').submit(function () {
    $('#metadata_location_#{l.id}').html(loadingHTML());

    var form = $(this);
    $.post(form.attr('action'), form.serialize(), function (data) {
      if (typeof data["error"] !== 'undefined') {
        show_ajax_message(JSON.stringify(data["error"]), 'error');
      }

      $('#metadata_location_#{l.id}').load('/locations/#{l.id}/render_update_metadata');
      updateLocationUpdatedText(#{l.id});
    });

    return false;
  });

  $('#metadata_cancel_#{l.id}, #location_detail_location_#{l.id} .meta_image').unbind('click').click(function () {
    $('#metadata_show_location_#{l.id}').toggle();
    $('#metadata_edit_location_#{l.id}').toggle();
  });
