- events = events.to_a
%div.quick_button_content_header
  - if events.empty?
    No upcoming events at this location
  - else
    = "#{pluralize(events.size, 'upcoming event')} at this location"
%p.upcoming_events_source
  Events mostly come from the
  = link_to 'IFPA calendar', 'https://www.ifpapinball.com/calendar/', :target => '_blank', :rel => 'noopener'
- events.each do |e|
  %div.upcoming_event
    %div.upcoming_event_name= e.name
    %div.upcoming_event_date= event_date_range(e)
    %div.upcoming_event_links
      - if e.ifpa_tournament_id
        = link_to 'IFPA calendar page', "https://www.ifpapinball.com/tournaments/view.php?t=#{e.ifpa_tournament_id}", :target => '_blank', :rel => 'noopener'
      - if e.external_link.to_s.match?(%r{\Ahttps?://}i)
        = link_to 'Event website', e.external_link, :target => '_blank', :rel => 'noopener nofollow'
    - if e.event_type.present?
      %div.upcoming_event_type
        %span.bold Tournament or league?
        %em= e.event_type
    - if e.long_desc.present?
      %details.upcoming_event_details
        %summary Details
        = simple_format(e.long_desc)
%p.upcoming_events_source.upcoming_events_missing
  Some IFPA events may be missing (due to sloppy data entry from tournament directors)
